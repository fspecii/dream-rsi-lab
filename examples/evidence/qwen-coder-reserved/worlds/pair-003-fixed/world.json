      "source": "import os\n\n\ndef normalize_path(path):\n    components = path.split('/')\n    stack = []\n    for component in components:\n        if component == '..':\n            if stack:\n                stack.pop()\n        elif component and component != '.':\n            stack.append(component)\n    result = '/' + '/'.join(stack)\n    return result or '/'\n",
