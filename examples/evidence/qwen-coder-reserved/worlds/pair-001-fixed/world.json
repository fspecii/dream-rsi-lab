      "source": "from math import ceil\n\ndef paginate(items, page, page_size):\n    if page_size <= 0:\n        return None\n    total = len(items)\n    pages = ceil(total / page_size)\n    page = max(1, min(page, pages))\n    start = (page - 1) * page_size\n    end = start + page_size\n    return {\n        'items': items[start:end],\n        'page': page,\n        'pages': pages,\n        'total': total\n    }",
